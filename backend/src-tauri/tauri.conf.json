{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "西语助手",
  "version": "0.0.1",
  "identifier": "com.spanishassistant.tauri",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:31420",
    "beforeDevCommand": "pnpm start",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "西语助手",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$APPDATA/**", "$APPDIR/**", "$APPCACHE/**"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 26
    },
    "iOS": {
      "developmentTeam": "12345",
      "minimumSystemVersion": "14.0"
    },
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "10.15"
    }
  }
}
